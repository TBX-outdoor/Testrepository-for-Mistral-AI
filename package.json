{
  "name": "mistral-chat",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Minimale Chat-Web-App mit dem offiziellen Mistral TypeScript SDK (mistral-small-latest)",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js"
  },
  "dependencies": {
    "@mistralai/mistralai": "3.5.0",
    "dotenv": "16.6.1",
    "express": "4.22.3"
  },
  "devDependencies": {
    "@types/express": "4.17.25",
    "@types/node": "22.20.5",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
